# Puerto del servidor
PORT=3000

# URL publica (sin barra final). En local: http://localhost:3000
APP_URL=http://localhost:3000

# Secretos. Cambialos en produccion.
JWT_SECRET=cambia-esto-por-un-secreto-largo
QR_PEPPER=cambia-esto-tambien

# Base de datos. Si definís TURSO_DATABASE_URL se usa Turso (libSQL en la nube).
# Si no, y definís DB_PATH, se usa un archivo SQLite local. Sin ninguna de las dos: backend/data/sella.db
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=pegá-aca-el-token
# DB_PATH=/data/app.db

# Google Wallet (opcional). Si falta algo, el pase corre en modo mock.
# GOOGLE_WALLET_ISSUER_ID=3388000000012345678
# GOOGLE_WALLET_CLIENT_EMAIL=sella-wallet@mi-proyecto.iam.gserviceaccount.com
# GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# GOOGLE_WALLET_CLASS_SUFFIX=sella_loyalty_v1
